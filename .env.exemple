# Réglages d'OptiLitige (version Supabase / Vercel).
# En ligne : à saisir dans Vercel (Project → Settings → Environment Variables), jamais dans Git.
# En local : rien d'obligatoire (base PGlite et connexion simulée) ; copier ce fichier en
# .env.development.local seulement pour essayer Supabase depuis le poste.

# Base PostgreSQL Supabase : bouton « Connect » → « Transaction pooler » (port 6543, adresse en
# …pooler.supabase.com), avec le mot de passe de la base. Jamais la « Direct connection »
# (db.….supabase.co) : joignable en IPv6 seulement.
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Projet Supabase : Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé de service (secret « service_role ») : serveur seulement, JAMAIS dans une variable NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Clé publique (« anon ») : sert seulement à la connexion Microsoft
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Compartiment des pièces jointes (créé par supabase/migrations)
SUPABASE_BUCKET=pieces-jointes

# Connexion : Microsoft par Supabase (obligatoire en ligne)
AUTH_MODE=supabase
# Domaines des adresses acceptées, séparés par des virgules
ALLOWED_EMAIL_DOMAINS=cybertek.fr
# Propriétaire de l'outil (toujours Admin) : le chef de projet. OBLIGATOIRE en ligne : sans elle,
# l'outil reste fermé (sinon le premier agent connecté deviendrait admin)
OWNER_EMAIL=
# Adresse publique du site, sans « / » final (ex. https://litiges.cybertek.fr) : redirections de
# connexion fixées, sans dépendre des en-têtes de la requête
APP_ORIGIN=
# Secret de la tâche de nuit de la corbeille des pièces jointes : texte aléatoire d'au moins
# 16 caractères ; Vercel l'envoie seul à /api/cron/corbeille. La tâche n'efface rien tant qu'un
# admin n'a pas activé le vidage (Paramètres → Corbeille des pièces jointes)
CRON_SECRET=

# Connexions facultatives (mêmes noms que la version Cloudflare). SHIPMENTS_TOKEN protège seul
# /api/shipments : au moins 24 caractères aléatoires
SHIPMENTS_TOKEN=
LAPOSTE_OKAPI_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
